# API 서버 주소
# 개발: http://<개발PC_LAN_IP>:8080   (실기기에서 localhost는 폰 자신을 가리킨다)
# 운영: https://eeum.life/api        (Nginx가 /api를 떼고 백엔드로 전달)
EXPO_PUBLIC_API_URL=

# 웹소켓 주소. 비워두면 API 주소에서 /api를 뗀 값 + /ws 로 자동 계산된다.
# 운영 기준 자동 계산 결과는 wss://eeum.life/ws 다. 구조가 달라질 때만 직접 지정한다.
# EXPO_PUBLIC_WS_URL=wss://eeum.life/ws

# 카카오 API 키 세팅
EXPO_PUBLIC_KAKAO_APP_KEY=여기에_카카오_앱_키를_입력하세요

# 네이버 API 키 세팅
EXPO_PUBLIC_NAVER_CLIENT_ID=여기에_네이버_클라이언트_아이디를_입력하세요
EXPO_PUBLIC_NAVER_CLIENT_SECRET=여기에_네이버_클라이언트_시크릿을_입력하세요

EXPO_PUBLIC_KAKAO_REST_API_KEY=여기에_카카오_리스트_에이피아이_키를_입력하세요

EXPO_PUBLIC_KAKAO_JS_KEY=여기에_카카오_제이에스_키를_입력하세요
# 포트원 스토어 ID
EXPO_PUBLIC_PORTONE_STORE_ID=

# 포트원 결제 채널 키
EXPO_PUBLIC_PORTONE_DEFAULT_KEY=
