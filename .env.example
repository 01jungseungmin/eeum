# ========================
# Database (MySQL)
# ========================
DB_URL=jdbc:mysql://localhost:3306/eeum
DB_USERNAME=root
DB_PASSWORD=root

# ========================
# Redis
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379

# ========================
# JWT
# ========================
JWT_SECRET=change-me-local-jwt-secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# ========================
# AWS S3
# ========================
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket
AWS_REGION=ap-northeast-2

# ========================
# PortOne
# ========================
PORTONE_API_KEY=your-portone-api-key
PORTONE_API_SECRET=your-portone-api-secret

# ========================
# Kakao OAuth
# ========================
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_REDIRECT_URI=http://localhost:8080/oauth/kakao/callback

# ========================
# Naver OAuth
# ========================
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:8080/oauth/naver/callback

# ========================
# FCM
# ========================
FCM_PROJECT_ID=your-firebase-project-id

# ========================
# 국세청 사업자번호 API
# ========================
NTS_API_KEY=your-nts-api-key